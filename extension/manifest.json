{
  "manifest_version": 3,
  "name": "noti-fai",
  "version": "0.1.2",
  "description": "Drops a bouncing ball on your desktop when an AI chat finishes replying in a background tab.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "icons": { "128": "icons/claude.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://grok.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
